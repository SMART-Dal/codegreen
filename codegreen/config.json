{
  "paths": {
    "runtime_modules": {
      "python": "runtime/codegreen_runtime.py",
      "base_directory": "${EXECUTABLE_DIR}/runtime"
    },
    "temp_directory": {
      "base": "${SYSTEM_TEMP}",
      "prefix": "codegreen_",
      "cleanup_on_exit": true,
      "max_age_hours": 24
    },
    "database": {
      "default_path": "${USER_HOME}/.codegreen/energy_data.db",
      "backup_enabled": true,
      "max_size_mb": 1024
    },
    "logs": {
      "directory": "${USER_HOME}/.codegreen/logs",
      "level": "INFO",
      "max_files": 10,
      "max_size_mb": 50
    }
  },
  "measurement": {
    "nemb": {
      "enabled": true,
      "coordinator": {
        "measurement_interval_ms": 10,
        "measurement_buffer_size": 100000,
        "auto_restart_failed_providers": true,
        "provider_restart_interval": 5000,
        "cross_validation": true,
        "cross_validation_threshold": 0.05
      },
      "timing": {
        "precision": "high",
        "clock_source": "auto"
      },
      "providers": {
        "intel_rapl": {
          "enabled": true,
          "domains": [
            "package",
            "pp0",
            "dram"
          ],
          "validation_enabled": true
        },
        "nvidia_nvml": {
          "enabled": true,
          "device_indices": [
            0
          ],
          "validation_enabled": true
        },
        "amd_rocm": {
          "enabled": false
        }
      },
      "accuracy": {
        "target_uncertainty_percent": 1.0,
        "measurement_validation": true,
        "outlier_detection": true,
        "noise_filtering": "adaptive",
        "statistical_validation": true,
        "confidence_threshold": 0.95
      }
    },
    "report": {
      "schema_version": "1",
      "iso_timestamp_format": "rfc3339_utc",
      "run_id_bytes": 6,
      "outlier_method": "iqr_1.5",
      "noise_warning": {
        "within_task_power_cv_pct_threshold": 10.0,
        "sampling_drop_ratio_threshold": 0.20,
        "quality_excellent_below_cv_pct": 2.0,
        "quality_good_below_cv_pct": 5.0,
        "quality_moderate_below_cv_pct": 10.0
      }
    }
  },
  "instrumentation": {
    "checkpoint_strategy": "functions",
    "track_invocations": true,
    "track_threads": true,
    "language_specific": {
      "python": {
        "instrument_loops": false,
        "max_recursion_depth": 100
      },
      "cpp": {
        "instrument_loops": false,
        "track_templates": true
      },
      "java": {
        "instrument_loops": false,
        "track_lambdas": true
      }
    }
  },
  "performance": {
    "string_optimization": {
      "cache_checkpoint_calls": true,
      "precompile_templates": true,
      "max_cache_size": 1000
    },
    "database": {
      "batch_operations": true,
      "transaction_size": 1000,
      "connection_pool_size": 5,
      "prepare_statements": true
    },
    "threading": {
      "max_worker_threads": 4,
      "measurement_thread_priority": "high"
    }
  },
  "security": {
    "sql_injection_protection": true,
    "path_validation": true,
    "temp_file_permissions": "0600"
  },
  "languages": {
    "python": {
      "executable": "python3",
      "runtime_module": "codegreen_runtime.py",
      "extensions": [
        ".py",
        ".pyw",
        ".pyi"
      ]
    },
    "c": {
      "executable": "gcc",
      "compiler_flags": [
        "-O0",
        "-g"
      ],
      "extensions": [
        ".c",
        ".h"
      ]
    },
    "cpp": {
      "executable": "g++",
      "compiler_flags": [
        "-O0",
        "-g",
        "-std=c++17"
      ],
      "extensions": [
        ".cpp",
        ".cxx",
        ".cc",
        ".hpp",
        ".h"
      ]
    },
    "java": {
      "executable": "java",
      "compiler": "javac",
      "extensions": [
        ".java"
      ]
    }
  },
  "hotspot_taxonomy": {
    "_comment": "Per-verdict thresholds for `codegreen project`'s per-function classifier. OCP-compliant: each verdict is a self-contained block; new verdicts can be added without touching dispatch code. Defaults match the historical hardcoded thresholds at codegreen/cli/cli.py:3424-3435 prior to extraction. CodeGreen detects wrapper / TYPE_1_DIRECT / TYPE_2_INEFFICIENT / TYPE_5_FREQUENCY / minor; TYPE_3_INDIRECT and TYPE_4_STRUCTURAL require callgraph analysis and are deferred to the consuming agent.",
    "wrapper": {
      "self_ratio_max": 0.2,
      "inclusive_pct_min": 5.0
    },
    "TYPE_1_DIRECT": {
      "exclusive_pct_min": 10.0
    },
    "TYPE_2_INEFFICIENT": {
      "exclusive_pct_min": 5.0,
      "efficiency_ratio_min": 3.0
    },
    "TYPE_5_FREQUENCY": {
      "calls_min": 100000,
      "exclusive_pct_min": 3.0,
      "efficiency_ratio_max": 1.5
    }
  },
  "developer": {
    "debug_mode": false,
    "verbose_logging": false,
    "preserve_temp_files": false,
    "measurement_validation": true,
    "performance_profiling": false
  },
  "initialization": {
    "completed": false,
    "timestamp": null,
    "environment_type": "unknown",
    "detected_sensors": []
  }
}