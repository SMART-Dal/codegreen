include README.md LICENSE requirements.txt pyproject.toml CMakeLists.txt setup.py
include config/codegreen.json

recursive-include codegreen/measurement CMakeLists.txt *.cpp *.c *.h *.hpp
recursive-include codegreen/instrumentation/language_runtimes *.py *.h *.hpp *.java
recursive-include codegreen/instrumentation/configs *.json
include codegreen/config.json

global-exclude *.pyc
global-exclude __pycache__
global-exclude *.so
global-exclude *.dylib
global-exclude *.dll
global-exclude *.jar
global-exclude *.class
global-exclude .DS_Store
global-exclude *.o
