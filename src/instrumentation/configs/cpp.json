{
    "name": "cpp",
    "extensions": [
        ".cpp",
        ".cxx",
        ".cc",
        ".hpp",
        ".h",
        ".hxx",
        ".h++"
    ],
    "tree_sitter_name": "cpp",
    "ast_config": {
        "body_field": "body",
        "block_type": "compound_statement",
        "function_types": [
            "function_definition"
        ],
        "class_types": [
            "class_specifier",
            "struct_specifier"
        ],
        "loop_types": [
            "for_statement",
            "while_statement",
            "do_statement"
        ],
        "return_types": [
            "return_statement"
        ],
        "comment_types": [
            "comment"
        ],
        "docstring_types": [],
        "insertion_rules": {
            "function_enter": {
                "mode": "inside_start",
                "find_first_statement": false,
                "skip_docstrings": false,
                "skip_comments": true
            },
            "function_exit": {
                "mode": "inside_end"
            },
            "function_return": {
                "mode": "immediately_before"
            },
            "loop_start": {
                "mode": "inside_start"
            },
            "before": {
                "mode": "before"
            },
            "after": {
                "mode": "after"
            }
        }
    },
    "custom_queries": {
        "definitions": "(function_definition declarator: (function_declarator declarator: (identifier) @function_name) body: (compound_statement)) @function_def",
        "loops": "(for_statement) @loop.for (while_statement) @loop.while (do_statement) @loop.do",
        "returns": "(return_statement) @return"
    },
    "query_config": {
        "capture_mapping": {
            "function_def": "function_enter",
            "function_name": "function_enter",
            "function.method": "function_enter",
            "local.definition.function": "function_enter",
            "return": "function_return"
        },
        "priority_order": [
            "function_def",
            "function_name",
            "function.method",
            "local.definition.function",
            "return"
        ],
        "deduplication_rules": {
            "function_enter": {
                "scope": "function",
                "priority_order": [
                    "function_def",
                    "function_name",
                    "function.method"
                ],
                "max_per_function": 1
            }
        }
    },
    "instrumentation_config": {
        "import_statement": "#include <codegreen/runtime.hpp>",
        "templates": {
            "function_enter": "CodeGreen::checkpoint(\"{checkpoint_id}\", \"{name}\", \"enter\");",
            "function_exit": "CodeGreen::checkpoint(\"{checkpoint_id}\", \"{name}\", \"exit\");",
            "function_return": "CodeGreen::checkpoint(\"{checkpoint_id}\", \"{name}\", \"exit\");",
            "loop_start": "CodeGreen::checkpoint(\"{checkpoint_id}\", \"{name}\", \"loop_start\");",
            "loop_exit": "CodeGreen::checkpoint(\"{checkpoint_id}\", \"{name}\", \"loop_exit\");"
        },
        "statement_terminator": ";",
        "comment_prefix": "//",
        "runtime_guard_files": [
            "runtime.hpp",
            "runtime.cpp"
        ]
    },
    "formatting_config": {
        "indent_size": 2,
        "indent_char": " ",
        "line_ending": "\n",
        "extra_indent_for_inside": 2
    },
    "rules": {
        "skip_docstrings": false,
        "skip_comments": true,
        "handle_async": false,
        "handle_decorators": false,
        "handle_generators": false,
        "special_exit_functions": []
    },
    "analysis_patterns": {
        "function_def": "^\\s*(?:(?:virtual|static|inline|explicit)\\s+)*(?:\\w+\\s+)*(\\w+)\\s*\\([^)]*\\)\\s*(?:const\\s*)?(?:override\\s*)?(?:final\\s*)?\\{?\\s*$",
        "class_def": "^\\s*class\\s+(\\w+)",
        "struct_def": "^\\s*struct\\s+(\\w+)",
        "for_loop": "^\\s*for\\s*\\(",
        "while_loop": "^\\s*while\\s*\\(",
        "new_op": "\\bnew\\s+",
        "delete_op": "\\bdelete\\s+"
    },
    "detection_patterns": {
        "include_directives": [
            "#include",
            "#define",
            "using namespace"
        ],
        "syntax_keywords": [
            "int main",
            "void ",
            "class ",
            "namespace "
        ],
        "regex": "^\\s*(#include|class\\s+\\w+|namespace\\s+\\w+)"
    },
    "processing_limits": {
        "max_captures_per_query": 10000,
        "max_lines_for_processing": 50000,
        "max_function_name_length": 100,
        "max_identifier_length": 50,
        "max_safety_counter": 10,
        "max_search_window": 50,
        "max_body_text_check": 200,
        "max_function_body_search_lines": 10,
        "max_file_size_mb": 100,
        "parser_timeout_ms": 30000,
        "max_parent_search_levels": 10,
        "debug_text_preview_length": 100,
        "debug_error_text_length": 200,
        "debug_significant_change_threshold": 100,
        "default_indent_size": 2,
        "max_inheritance_depth": 5
    },
    "node_types": {
        "function_types": [
            "function_definition"
        ],
        "body_types": [
            "compound_statement",
            "class_body"
        ],
        "loop_types": [
            "for_statement",
            "while_statement",
            "do_statement"
        ],
        "class_types": [
            "class_specifier",
            "struct_specifier"
        ],
        "comment_types": [
            "comment"
        ],
        "return_types": [
            "return_statement"
        ],
        "throw_types": [
            "throw_statement"
        ],
        "constructor_invocation_types": [],
        "import_after_node_types": [],
        "terminating_types": [
            "return_statement",
            "throw_statement",
            "break_statement",
            "continue_statement"
        ],
        "identifier_types": [
            "identifier",
            "type_identifier",
            "field_identifier",
            "namespace_identifier"
        ],
        "definition_types": [
            "function_definition",
            "class_specifier",
            "struct_specifier"
        ],
        "if_statement_types": [
            "if_statement"
        ],
        "else_clause_types": [],
        "elif_clause_types": [],
        "try_statement_types": [
            "try_statement"
        ],
        "catch_clause_types": [
            "catch_clause"
        ],
        "finally_clause_types": [],
        "for_statement_types": [
            "for_statement"
        ],
        "docstring_node_types": [],
        "docstring_delimiters": [],
        "comment_prefix": "//",
        "indentation_sensitive": false
    },
    "project_config": {
        "source_patterns": [
            "**/src/**/*.cpp",
            "**/src/**/*.cc",
            "**/*.cpp"
        ],
        "exclude_patterns": [
            "**/test/**",
            "**/tests/**",
            "**/.git/**",
            "**/build/**"
        ],
        "build_systems": {
            "cmake": {
                "detect": "CMakeLists.txt",
                "build_cmd": "cmake --build build"
            },
            "make": {
                "detect": "Makefile",
                "build_cmd": "make"
            }
        },
        "runtime_injection": {
            "type": "include_link",
            "include_flag": "-I${CODEGREEN_RUNTIME}",
            "link_flag": "-L${CODEGREEN_LIB} -lcodegreen-nemb"
        },
        "source_root_markers": [
            "src"
        ]
    }
}